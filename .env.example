# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=securepass
POSTGRES_DB=aidb
DATABASE_URL=postgresql+asyncpg://postgres:securepass@postgres:5432/aidb

# Qdrant Vector Database
QDRANT_URL=http://qdrant:6333

# Ollama AI Server (IP del server con GPU)
OLLAMA_BASE_URL=http://192.168.1.xxx:11434

# Google OAuth Configuration
GOOGLE_CLIENT_ID=inserisci_il_tuo_client_id_qui
GOOGLE_CLIENT_SECRET=inserisci_il_tuo_secret_qui

# JWT Configuration
JWT_SECRET_KEY=cambia_questa_stringa_in_produzione_con_una_lunga_random
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,https://tuo-dominio.it

# Access Control
ALLOWED_EMAILS=admin@example.com,user@example.com

# Environment
ENVIRONMENT=development
